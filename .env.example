# Public URL of the site, used for metadata (e.g. https://securelifeagency.com)
NEXT_PUBLIC_SITE_URL=

# Application emails are sent with Resend (https://resend.com).
RESEND_API_KEY=
# Where applications go — Cole's inbox. Separate multiple addresses with commas.
APPLICATION_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "Secure Life Agency <applications@securelifeagency.com>"
APPLICATION_FROM_EMAIL=

# Optional: Google Form used for applications while email isn't set up.
# Defaults to Cole's form; set to an empty value to turn it off.
# APPLICATION_FORM_URL=

# Optional: booking link (Calendly, Cal.com, …) shown on the thank-you page.
NEXT_PUBLIC_SCHEDULING_URL=

# Optional: show "To confirm" placeholders on a deployed preview (they're hidden on production builds by default).
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
